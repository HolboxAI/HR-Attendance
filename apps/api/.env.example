# Prototype defaults need no configuration at all - leave this file unused and
# everything lands in ../../data/. These are here for when that changes.

# DATABASE_URL=sqlite:///../../data/boxcode.db
# Production: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/boxcode_hrms

# FACE_PROVIDER=stub          # "rekognition" once there is an AWS account
# AWS_REGION=ap-south-1
# JWT_SECRET=change-me

# Refuse a punch from someone with no reference photo. Leave false until the
# dashboard's enrolment screen reads 100%, then turn it on - that is the
# moment the face check starts being load-bearing.
# REQUIRE_FACE_ENROLMENT=false
