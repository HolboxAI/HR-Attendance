# Prototype defaults need no configuration at all - leave this file unused and
# everything lands in ../../data/. These are here for when that changes.

# DATABASE_URL=sqlite:///../../data/boxcode.db
# Production: DATABASE_URL=postgresql+psycopg://user:pass@host:5432/boxcode_hrms

# FACE_PROVIDER=stub          # "rekognition" once there is an AWS account
# AWS_REGION=ap-south-1

# Credentials for the DEDICATED app user, not a personal key - see
# docs/AWS-CREDENTIALS.md and infra/iam-policy.json. Verify with:
#     .venv/bin/python scripts/check_aws.py
# Leave BOTH unset in production and attach an IAM instance role instead;
# app/core/aws.py falls through to boto3's default chain when they are absent.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# JWT_SECRET=change-me           # MUST be changed before anyone real uses this
# ACCESS_TOKEN_MINUTES=30
# REFRESH_TOKEN_DAYS=30

# Public URL of THIS API, used in Slack and email links (sick-leave documents,
# leave approve/reject). Must be reachable from a phone, not localhost.
# If this points at the wrong host, attachments "arrive" but will not open.
# API_URL=https://attendance.holbox.ai/api/v1

# One handset per employee, checked on every punch. HR clears a binding with
# DELETE /api/v1/admin/devices/{employee_code} when someone changes phone.
# REQUIRE_DEVICE_BINDING=true

# Shared secret for the parked gate-reader path. Empty = the endpoint is closed.
# DEVICE_INGEST_KEY=""

# Refuse a punch from someone with no reference photo. Leave false until the
# dashboard's enrolment screen reads 100%, then turn it on - that is the
# moment the face check starts being load-bearing.
# REQUIRE_FACE_ENROLMENT=false
