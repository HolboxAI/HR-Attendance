{
  "expo": {
    "name": "Holbox Attendance",
    "slug": "holbox-attendance",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.holbox.attendance",
      "infoPlist": {
        "NSCameraUsageDescription": "Holbox uses the camera to confirm it's you when you check in.",
        "NSLocationWhenInUseUsageDescription": "Holbox checks your location to confirm you're at the office when you check in."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.holbox.attendance",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "holbox",
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Holbox uses the camera to confirm it's you when you check in."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Holbox checks your location to confirm you're at the office when you check in."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/android-icon-monochrome.png",
          "color": "#141BC8",
          "defaultChannel": "attendance"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5e7d5891-e037-43c0-8fc8-8ed4b89c9bbf"
      }
    },
    "owner": "holboxai"
  }
}
